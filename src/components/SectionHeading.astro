---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  align?: 'left' | 'center';
}
const { eyebrow, title, lead, align = 'left' } = Astro.props;
---
<div class:list={['section-heading', align]} data-reveal>
  <p class="eyebrow">{eyebrow}</p>
  <h2>{title}</h2>
  {lead && <p class="lead">{lead}</p>}
</div>

<style>
  .section-heading {
    margin-bottom: var(--p-space-12);
    max-width: 46rem;
  }

  .section-heading.center {
    margin-inline: auto;
    text-align: center;
  }

  .section-heading.center .lead {
    margin-inline: auto;
  }
</style>

---
import { nav, site } from '../config';
import Icon from './Icon.astro';

const base = import.meta.env.BASE_URL;
const withBase = (href: string) => (href === '/' ? base : `${base}${href.replace(/^\//, '')}`);
const current = Astro.url.pathname;
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={withBase('/')} aria-label={`${site.name} — home`}>
      <span class="brand-mark" aria-hidden="true">
        <svg width="30" height="30" viewBox="0 0 32 32" fill="none">
          <path
            d="M16 28S5.5 21.6 3 15.7C1.2 11.5 4 7 8.6 7c2.6 0 4.9 1.5 5.9 3.6L16 12l1.5-1.4C18.5 8.5 20.8 7 23.4 7 28 7 30.8 11.5 29 15.7 26.5 21.6 16 28 16 28Z"
            fill="currentColor"
            opacity="0.92"
          />
          <path
            d="M16 28c1.8-4.6 1.8-9.4 0-14-1.8 4.6-1.8 9.4 0 14Z"
            fill="#FDFBF7"
            opacity="0.85"
          />
        </svg>
      </span>
      <span class="brand-text">
        <strong>Little Heart Space</strong>
        <small>Family &amp; Art Therapy</small>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Primary">
      {
        nav.map((item) => (
          <a
            href={withBase(item.href)}
            class:list={['nav-link', { active: current === withBase(item.href) }]}
            aria-current={current === withBase(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a class="btn btn-primary btn-sm" href={withBase('/contact/')}>Book a consultation</a>
    </nav>

    <button class="menu-btn" id="menuBtn" aria-expanded="false" aria-controls="mobileNav" aria-label="Open menu">
      <span class="icon-open"><Icon name="menu" /></span>
      <span class="icon-close"><Icon name="close" /></span>
    </button>
  </div>

  <nav class="mobile-nav" id="mobileNav" aria-label="Mobile">
    {
      nav.map((item) => (
        <a
          href={withBase(item.href)}
          class:list={['mobile-link', { active: current === withBase(item.href) }]}
        >
          {item.label}
        </a>
      ))
    }
    <a class="btn btn-primary" href={withBase('/contact/')}>Book a consultation</a>
  </nav>
</header>

<script>
  const btn = document.getElementById('menuBtn');
  const nav = document.getElementById('mobileNav');
  btn?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open') ?? false;
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--header-bg);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--header-border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--p-space-4);
    padding-block: var(--p-space-3);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--p-space-3);
    text-decoration: none;
    color: var(--color-text);
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: var(--p-radius-blob);
    background: linear-gradient(135deg, var(--p-euca-500), var(--p-euca-700));
    color: var(--p-clay-200);
    box-shadow: var(--p-shadow-sm);
  }

  .brand-text {
    display: grid;
    line-height: 1.25;
  }

  .brand-text strong {
    font-family: var(--font-display);
    font-size: 1.12rem;
    font-weight: 700;
  }

  .brand-text small {
    font-size: var(--p-text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    font-weight: 600;
  }

  .desktop-nav {
    display: none;
    align-items: center;
    gap: var(--p-space-2);
  }

  @media (min-width: 900px) {
    .desktop-nav {
      display: inline-flex;
    }
    .menu-btn {
      display: none;
    }
  }

  .nav-link {
    padding: var(--p-space-2) var(--p-space-4);
    border-radius: var(--p-radius-pill);
    text-decoration: none;
    color: var(--color-text-muted);
    font-weight: 600;
    font-size: var(--p-text-sm);
    transition:
      color var(--transition-hover),
      background-color var(--transition-hover);
  }

  .nav-link:hover {
    color: var(--color-text);
    background: var(--color-surface-warm);
  }

  .nav-link.active {
    color: var(--color-brand-ink);
    background: var(--color-brand-soft);
  }

  .btn-sm {
    padding: var(--p-space-2) var(--p-space-5);
    font-size: var(--p-text-sm);
    margin-left: var(--p-space-2);
  }

  .menu-btn {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--p-radius-sm);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text);
    cursor: pointer;
  }

  .menu-btn .icon-close {
    display: none;
  }

  .menu-btn[aria-expanded='true'] .icon-open {
    display: none;
  }

  .menu-btn[aria-expanded='true'] .icon-close {
    display: block;
  }

  .mobile-nav {
    display: none;
    flex-direction: column;
    gap: var(--p-space-1);
    padding: 0 var(--p-space-4) var(--p-space-5);
  }

  .mobile-nav.open {
    display: flex;
  }

  .mobile-link {
    padding: var(--p-space-3) var(--p-space-4);
    border-radius: var(--p-radius-sm);
    text-decoration: none;
    color: var(--color-text);
    font-weight: 600;
  }

  .mobile-link:hover {
    background: var(--color-surface-warm);
  }

  .mobile-link.active {
    background: var(--color-brand-soft);
    color: var(--color-brand-ink);
  }

  .mobile-nav .btn {
    margin-top: var(--p-space-3);
  }
</style>
